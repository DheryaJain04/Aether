<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results</title>
</head>

<body>
    <h1>Search Results</h1>
    <h2>
        <%= query %>
    </h2>
    <hr>
    <% papers.forEach(paper => { %>
        <div>
            <h3>
                <%= paper.display_name %>
            </h3>

            <p>
                Year :
                <%= paper.publication_year %>
            </p>
            <hr>
        </div>
    <% }) %>
</body>
</html>


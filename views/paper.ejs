<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= paper.title %> | Aether</title>
    <link rel="stylesheet" href="/css/paper.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<div class="background-effects">
    <div class="wave wave-one"></div>
    <div class="wave wave-two"></div>
    <div class="wave wave-three"></div>
</div>

<header class="top-bar">
    <a href="/" class="logo">Aether</a>

    <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/search?q=<%= encodeURIComponent(searchQuery) %>">Search Results</a>
        <span>/</span>
        <span class="current">Paper</span>
    </nav>
</header>

<main>

<section class="paper-hero">
    <div class="hero-glow"></div>

    <div class="hero-content">

        <div class="paper-badges">
            <% if(paper.openAccess){ %>
                <span class="open-access">
                    <span class="status-dot"></span>
                    OPEN ACCESS
                </span>
            <% } %>

            <% if(paper.year){ %>
                <span class="year-badge">
                    <%= paper.year %>
                </span>
            <% } %>
        </div>

        <h1 class="paper-title">
            <%= paper.title %>
        </h1>

        <p class="paper-authors">
            <%= paper.authors %>
        </p>

        <div class="paper-meta">
            <div class="meta-item">
                <span class="meta-label">PUBLISHED IN</span>
                <strong><%= paper.journal %></strong>
            </div>

            <div class="meta-divider"></div>

            <div class="meta-item">
                <span class="meta-label">YEAR</span>
                <strong><%= paper.year %></strong>
            </div>
        </div>

        <% if(paper.doi){ %>
            <a
                href="https://doi.org/<%= paper.doi %>"
                target="_blank"
                class="doi-badge"
            >
                <strong>DOI</strong>
                <span><%= paper.doi %></span>
                <span class="external-arrow">↗</span>
            </a>
        <% } %>

    </div>
</section>

<section class="ai-workspace">

    <div class="workspace-glow"></div>

    <div class="ai-grid">

        <div class="summary-section">

            <div class="section-heading-row">
                <div>
                    <span class="ai-label">✦ AI GENERATED</span>
                    <h2>Aether Summary</h2>
                </div>

                <span class="aether-ai-badge">
                    Aether AI
                </span>
            </div>

            <div class="summary-card">
                <div class="summary-shine"></div>

                <p id="summary">
                    <%= paper.summary %>
                </p>
            </div>

        </div>

        <aside class="chat-panel">

            <div class="chat-glow"></div>

            <div class="chat-header">

                <div class="chat-brand">
                    <div class="ai-icon">✦</div>

                    <div>
                        <h3>Ask Aether</h3>
                        <p>Chat with this paper</p>
                    </div>
                </div>

                <span class="ai-status">
                    <span></span>
                    AI
                </span>

            </div>

            <div class="grounded-notice">
                <span>⌕</span>
                Answers are grounded in the full text of this research paper.
            </div>

            <div id="chat-messages" class="chat-messages">

                <div class="message-row aether-row">
                    <div class="message-avatar">✦</div>

                    <div class="message-content">
                        <span class="message-name">AETHER</span>

                        <div class="aether-message">
                            Ask me anything about this research paper. I can help explain concepts, methodology, findings, and more.
                        </div>
                    </div>
                </div>

            </div>

            <div class="suggested-questions">
                <button type="button" data-question="What is the main contribution of this paper?">
                    Main contribution
                </button>

                <button type="button" data-question="What methodology does this paper use?">
                    Methodology
                </button>

                <button type="button" data-question="What are the key findings of this paper?">
                    Key findings
                </button>
            </div>

            <form id="chat-form" class="chat-form">

                <input
                    type="text"
                    id="chat-input"
                    placeholder="Ask about this paper..."
                    autocomplete="off"
                    required
                >

                <button type="submit" class="send-btn">
                    ↑
                </button>

            </form>

            <p class="chat-footer">
                Aether answers using retrieved context from the paper.
            </p>

        </aside>

    </div>

</section>

<section class="paper-content">

    <div class="content-section abstract-section">

        <div class="content-heading">
            <span class="section-number">01</span>
            <h2>Abstract</h2>
        </div>

        <p class="abstract-text">
            <%= paper.abstract %>
        </p>

    </div>

    <div class="content-section keywords-section">

        <div class="content-heading">
            <span class="section-number">02</span>
            <h2>Keywords</h2>
        </div>

        <div class="keyword-list" id="keyword-list">
            <span class="keyword loading-keyword">
                Generating Keywords...
            </span>
        </div>

    </div>

    <div class="content-section citations-section">

        <div class="content-heading">
            <span class="section-number">03</span>
            <h2>Citations</h2>
        </div>

        <p class="section-description">
            Ready-to-use citations for this research paper.
        </p>

        <div class="citations-grid">

            <div class="citation-card">

                <div class="citation-top">
                    <span class="citation-type">APA</span>

                    <button
                        type="button"
                        class="copy-btn"
                        data-target="apa-citation"
                    >
                        Copy
                    </button>
                </div>

                <p id="apa-citation">
                    <%= paper.citations.apa %>
                </p>

            </div>

            <div class="citation-card">

                <div class="citation-top">
                    <span class="citation-type">IEEE</span>

                    <button
                        type="button"
                        class="copy-btn"
                        data-target="ieee-citation"
                    >
                        Copy
                    </button>
                </div>

                <p id="ieee-citation">
                    <%= paper.citations.ieee %>
                </p>

            </div>

        </div>

    </div>

</section>

</main>

<script>

const paperId = "<%= paper.id %>";

async function loadSummary(){
    try{
        const response = await fetch(`/paper/${paperId}/summary`);
        const data = await response.json();

        console.log("SUMMARY DEBUG:", data);

        document.getElementById("summary").innerText = data.summary;
    }
    catch(err){
        console.log("SUMMARY ERROR:", err);

        document.getElementById("summary").innerText =
            "Unable to generate summary.";
    }
}

async function loadKeywords(){
    try{
        const response = await fetch(`/paper/${paperId}/keywords`);
        const data = await response.json();

        const keywordList = document.getElementById("keyword-list");

        if(!response.ok || !data.keywords){
            throw new Error("Unable to load keywords");
        }

        keywordList.innerHTML = "";

        data.keywords.forEach(keyword=>{
            const span = document.createElement("span");
            span.className = "keyword";
            span.innerText = keyword;
            keywordList.appendChild(span);
        });
    }
    catch(err){
        document.getElementById("keyword-list").innerHTML =
            '<span class="keyword">Unavailable</span>';
    }
}

const chatForm = document.getElementById("chat-form");
const chatInput = document.getElementById("chat-input");
const chatMessages = document.getElementById("chat-messages");

async function sendQuestion(question){

    if(!question.trim()){
        return;
    }

    const userRow = document.createElement("div");
    userRow.className = "message-row user-row";

    userRow.innerHTML = `
        <div class="message-content">
            <span class="message-name user-name">YOU</span>
            <div class="user-message"></div>
        </div>
    `;

    userRow.querySelector(".user-message").innerText = question;
    chatMessages.appendChild(userRow);

    const loadingRow = document.createElement("div");
    loadingRow.className = "message-row aether-row";

    loadingRow.innerHTML = `
        <div class="message-avatar">✦</div>
        <div class="message-content">
            <span class="message-name">AETHER</span>
            <div class="aether-message loading-answer">
                Aether is reading the paper
                <span class="loading-dots">...</span>
            </div>
        </div>
    `;

    chatMessages.appendChild(loadingRow);

    chatMessages.scrollTop = chatMessages.scrollHeight;

    try{

        const response = await fetch(
            `/paper/${paperId}/chat`,
            {
                method:"POST",
                headers:{
                    "Content-Type":"application/json"
                },
                body:JSON.stringify({
                    question
                })
            }
        );

        const data = await response.json();

        if(!response.ok){
            throw new Error(data.error || "Unable to answer question");
        }

        loadingRow.querySelector(".aether-message").innerText =
            data.answer;

    }
    catch(err){

        loadingRow.querySelector(".aether-message").innerText =
        err.message || "Aether was unable to process this paper. Please try again.";
    }

    chatMessages.scrollTop = chatMessages.scrollHeight;
}

chatForm.addEventListener("submit", async(event)=>{

    event.preventDefault();

    const question = chatInput.value.trim();

    if(!question){
        return;
    }

    chatInput.value = "";

    await sendQuestion(question);

});

document.querySelectorAll(".suggested-questions button")
.forEach(button=>{

    button.addEventListener("click", async()=>{

        const question = button.dataset.question;

        await sendQuestion(question);

    });

});

document.querySelectorAll(".copy-btn")
.forEach(button=>{

    button.addEventListener("click", async()=>{

        const targetId = button.dataset.target;

        const text =
            document.getElementById(targetId).innerText;

        await navigator.clipboard.writeText(text);

        const originalText = button.innerText;

        button.innerText = "Copied";

        setTimeout(()=>{
            button.innerText = originalText;
        },1500);

    });

});

loadSummary();
loadKeywords();

</script>

</body>
</html>
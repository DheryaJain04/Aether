<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= paper.title %> | Aether</title>
    <link rel="stylesheet" href="/css/paper.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
<header class="top-bar">
    <h1 class="logo">Aether</h1>

    <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/search?q=<%= encodeURIComponent(searchQuery) %>">
            Search Results
        </a>
        <span>/</span>
        <span class="current">
            Paper
        </span>
    </nav>
</header>

<hr>

<h2>
<%= paper.title %>
</h2>

<p>
<%= paper.authors %>
</p>

<p>
<%= paper.journal %> • <%= paper.year %>
</p>

<% if(paper.openAccess){ %>
<p>
🟢 Open Access
</p>
<% } %>

<% if(paper.doi){ %>
<p>
DOI • <%= paper.doi %>
</p>
<% } %>

<hr>

<h3>
Aether Summary
</h3>
<p id="summary">
    <%= paper.summary %>
</p>

<hr>

<h3>
Abstract
</h3>
<p>
<%= paper.abstract %>
</p>

<hr>

<h3>
Keywords
</h3>
<div class="keyword-list" id="keyword-list">
    <span class="keyword">Generating Keywords...</span>
</div>

<hr>

<h3>
Citations
</h3>

<p>
APA
</p>
<p>
<%= paper.citations.apa %>
</p>

<br>

<p>
IEEE
</p>
<p>
<%= paper.citations.ieee %>
</p>

<hr>

<h3>Ask Aether</h3>

<div class="chat-container">
    <div id="chat-messages" class="chat-messages">
        <div class="aether-message">
            Ask me anything about this research paper.
        </div>
    </div>

    <form id="chat-form" class="chat-form">
        <input
            type="text"
            id="chat-input"
            placeholder="Ask a question about this paper..."
            autocomplete="off"
            required
        >
        <button type="submit">
            Ask
        </button>
    </form>
</div>

<script>
const paperId = "<%= paper.id %>";

async function loadSummary(){
    try{
        const response = await fetch(`/paper/${paperId}/summary`);
        const data = await response.json();
        document.getElementById("summary").innerText = data.summary;
    }
    catch(err){
        document.getElementById("summary").innerText =
            "Unable to generate summary.";
    }
}

async function loadKeywords(){
    try{
        const response = await fetch(`/paper/${paperId}/keywords`);
        const data = await response.json();
        const keywordList = document.getElementById("keyword-list");
        keywordList.innerHTML = "";
        data.keywords.forEach(keyword=>{
            const span = document.createElement("span");
            span.className = "keyword";
            span.innerText = keyword;
            keywordList.appendChild(span);
        });
    }catch(err){
        document.getElementById("keyword-list").innerText =
            "Unable to generate keywords.";
    }
}

const chatForm = document.getElementById("chat-form");
const chatInput = document.getElementById("chat-input");
const chatMessages = document.getElementById("chat-messages");

chatForm.addEventListener("submit",async(event)=>{
    event.preventDefault();

    const question = chatInput.value.trim();

    if(!question){
        return;
    }

    const userMessage = document.createElement("div");
    userMessage.className = "user-message";
    userMessage.innerText = question;
    chatMessages.appendChild(userMessage);

    chatInput.value = "";

    const loadingMessage = document.createElement("div");
    loadingMessage.className = "aether-message";
    loadingMessage.innerText = "Aether is reading the paper...";
    chatMessages.appendChild(loadingMessage);

    chatInput.disabled = true;

    try{
        const response = await fetch(
            `/paper/${paperId}/chat`,
            {
                method:"POST",
                headers:{
                    "Content-Type":"application/json"
                },
                body:JSON.stringify({
                    question
                })
            }
        );

        const data = await response.json();

        if(!response.ok){
            loadingMessage.innerText =
                data.error ||
                "Unable to answer your question.";

            return;
        }

        loadingMessage.innerText = data.answer;
    }catch(err){
        loadingMessage.innerText =
            "Unable to connect to Aether right now.";
    }finally{
        chatInput.disabled = false;
        chatInput.focus();
    }
});

loadSummary();
loadKeywords();

</script>
</body>
</html>